+static bool replaceParameter(
+        std::string* parameters, const char* key,
+        const char* expected, const char* replacement) {
+    const std::string token = std::string(key) + "=" + expected;
+    size_t position = parameters->find(token);
+
+    while (position != std::string::npos) {
+        const size_t end = position + token.size();
+        if ((position == 0 || (*parameters)[position - 1] == ';') &&
+                (end == parameters->size() || (*parameters)[end] == ';')) {
+            parameters->replace(position, token.size(),
+                    std::string(key) + "=" + replacement);
+            return true;
+        }
+        position = parameters->find(token, position + 1);
+    }
+    return false;
+}

