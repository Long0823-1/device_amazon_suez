# Android fstab file.
#<src>           <mnt_point>         <type>    <mnt_flags and options>                 <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

/dev/block/platform/mtk-msdc.0/by-name/userdata   /data        ext4   noatime,nosuid,nodev,noauto_da_alloc    check,encryptable=/dev/block/platform/mtk-msdc.0/by-name/metadata
/dev/block/platform/mtk-msdc.0/by-name/cache      /cache       ext4   noatime,nosuid,nodev,noauto_da_alloc    check

# zram swap: earlier attempts at 75% and 25% both caused video playback
# stutter on this 2GB RAM / dual-core SoC. Root cause turned out to be the
# compression backend, not zram itself: CONFIG_ZRAM defaults to LZO (good
# ratio, high CPU cost per op), which was competing with real-time video
# decode. Re-enabled at a conservative 15% using MediaTek's own LZ4K
# compressor instead (suez_defconfig), which is much lighter on CPU per
# operation. Paired with a low vm.swappiness (init.mt8173.rc) so the
# kernel only reaches for swap under real memory pressure rather than
# proactively, instead of tuning zram size back down again if this still
# isn't enough headroom.
/dev/block/zram0    none                swap   defaults        zramsize=15%,max_comp_streams=2

/devices/soc/11240000.mmc*  auto      auto      defaults        voldmanaged=sdcard1:auto,encryptable=userdata
/devices/soc/11270000.usb*  auto      auto      defaults        voldmanaged=usbotg:auto


/dev/block/platform/mtk-msdc.0/by-name/proinfo       /proinfo        emmc  defaults defaults
/dev/block/platform/mtk-msdc.0/by-name/lk            /bootloader     emmc  defaults defaults
/dev/block/platform/mtk-msdc.0/by-name/lk2           /bootloader2    emmc  defaults defaults
/dev/block/platform/mtk-msdc.0/by-name/boot          /boot           emmc  defaults defaults
/dev/block/platform/mtk-msdc.0/by-name/recovery      /recovery       emmc  defaults defaults
/dev/block/platform/mtk-msdc.0/by-name/tee1          /tee1           emmc  defaults defaults
/dev/block/platform/mtk-msdc.0/by-name/tee2          /tee2           emmc  defaults defaults
